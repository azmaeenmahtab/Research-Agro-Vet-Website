# dependencies
node_modules/
/node_modules/
express-api/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage
.nyc_output/

# next.js
/.next/
/out/

# production & builds
/build
dist/
/dist
express-api/dist/
express-api/uploads/
cpanel-deployment/
*.zip
*.sql
response.html

# misc & OS
.DS_Store
Thumbs.db
*.pem

# IDEs & editors
.vscode/
.idea/
*.swp
*.swo
*~

# debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow example templates)
.env*
!.env.example
!express-api/.env.example

# vercel & turborepo
.vercel
.turbo

# typescript
*.tsbuildinfo
next-env.d.ts

